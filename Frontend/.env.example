# ========================================
# UNIVOTE FRONTEND - VARIABLES DE ENTORNO
# ========================================
#
# Copia este archivo a .env y ajusta según tu entorno
# 
# ⚠️ IMPORTANTE:
# - En Vite, todas las variables DEBEN tener prefijo VITE_
# - Después de cambiar variables, reinicia el servidor (npm run dev)
# - Nunca subas archivos .env con datos reales a Git
#

# ========================================
# BACKEND API
# ========================================
# URL base del servidor Backend

# Desarrollo local (por defecto)
VITE_API_URL=http://localhost:3000

# Para desarrollo con Docker
# VITE_API_URL=http://localhost:3000

# Para producción
# VITE_API_URL=https://api.univote.example.com

# ========================================
# OTRAS VARIABLES (Opcional)
# ========================================
# Puedes agregar más variables según necesites
# Recuerda siempre usar el prefijo VITE_

# Ejemplo: Habilitar modo debug
# VITE_DEBUG_MODE=true

# Ejemplo: Nombre de la aplicación
# VITE_APP_NAME=Univote

# Ejemplo: Versión
# VITE_APP_VERSION=1.0.0
