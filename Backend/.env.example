# ========================================
# UNIVOTE BACKEND - VARIABLES DE ENTORNO
# ========================================
# 
# Este archivo contiene ejemplos de configuración para diferentes entornos.
# Copia este archivo y renómbralo según tu entorno:
#   - Desarrollo local: .env.local
#   - Docker: .env
#   - Producción: .env.production
#
# ⚠️ IMPORTANTE: Nunca subas archivos .env con datos reales a Git
#

# ========================================
# CONFIGURACIÓN DE DOCKER COMPOSE
# ========================================
# Estas variables son usadas por docker-compose.yml

POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=Univote

# ========================================
# BASE DE DATOS
# ========================================
# Formato: postgresql://[usuario]:[contraseña]@[host]:[puerto]/[database]?schema=public

# Para Docker (usar 'db' como host)
DATABASE_URL=postgresql://postgres:admin@db:5432/Univote?schema=public

# Para desarrollo local SIN contraseña
# DATABASE_URL=postgresql://postgres:@localhost:5432/Univote?schema=public

# Para desarrollo local CON contraseña
# DATABASE_URL=postgresql://postgres:tu_contraseña@localhost:5432/Univote?schema=public

# ========================================
# JWT (JSON Web Token)
# ========================================
# Secreto para firmar tokens - CAMBIAR EN PRODUCCIÓN
# Genera uno seguro con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=change_this_in_production_use_strong_random_string

# Tiempo de expiración del token (ejemplos: 1h, 24h, 7d, 30d)
JWT_EXPIRES_IN=24h

# ========================================
# CORS (Cross-Origin Resource Sharing)
# ========================================
# Orígenes permitidos para hacer peticiones al backend
# Separar múltiples orígenes con coma

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Para producción, usar dominios reales:
# ALLOWED_ORIGINS=https://univote.example.com,https://www.univote.example.com

# ========================================
# SERVIDOR
# ========================================
# Puerto en el que correrá el backend

PORT=3000

# ========================================
# PGADMIN (Opcional - Solo Docker)
# ========================================
# Interfaz web para administrar PostgreSQL
# Accesible en http://localhost:5050

PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# ========================================
# EMAIL (Opcional)
# ========================================
# Configuración para envío de correos (notificaciones, contacto)
# Para Gmail, generar contraseña de aplicación en:
# https://myaccount.google.com/apppasswords

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# ========================================
# EJEMPLOS POR ENTORNO
# ========================================

# ---------------
# DESARROLLO LOCAL (Windows/macOS/Linux)
# ---------------
# Copia estas líneas a .env.local y descomenta
# DATABASE_URL=postgresql://postgres:@localhost:5432/Univote?schema=public
# JWT_SECRET=dev_secret_local_2024_change_me
# JWT_EXPIRES_IN=24h
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# PORT=3000

# ---------------
# DOCKER
# ---------------
# Copia estas líneas a .env
# DATABASE_URL=postgresql://postgres:admin@db:5432/Univote?schema=public
# JWT_SECRET=docker_dev_secret_2024_change_me
# JWT_EXPIRES_IN=24h
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=admin
# POSTGRES_DB=Univote

# ---------------
# PRODUCCIÓN
# ---------------
# DATABASE_URL=postgresql://prod_user:STRONG_PASSWORD@prod-db.com:5432/univote?schema=public&sslmode=require
# JWT_SECRET=GENERATE_STRONG_RANDOM_STRING_MIN_32_CHARS
# JWT_EXPIRES_IN=12h
# ALLOWED_ORIGINS=https://univote.com,https://www.univote.com
# EMAIL_USER=noreply@univote.com
# EMAIL_PASS=production_email_password
# PORT=3000
